generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgencyProfile {
  id        String   @id @default(cuid())
  name      String   @default("Agencia Digital")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id               String   @id @default(cuid())
  name             String   @default("Clínica Dental Lumen")
  activity         String   @default("Clínica odontológica integral y estética dental")
  address          String   @default("Calle Gran Vía 42, 2º Izquierda, 28013 Madrid")
  phone            String   @default("+34 912 345 678")
  website          String   @default("https://clinicalumen.es")
  timezone         String   @default("Europe/Madrid")
  assistantEnabled Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model AssistantConfig {
  id                String   @id @default(cuid())
  name              String   @default("LumenBot")
  avatarUrl         String   @default("/avatar.png")
  tone              String   @default("cercano") // cercano, profesional, directo
  welcomeMessage    String   @default("¡Hola! 👋 Soy el asistente virtual de Clínica Dental Lumen. ¿En qué puedo ayudarte hoy? Puedo informarte sobre nuestros tratamientos, resolver tus dudas o agendar tu cita.")
  instructions      String   @default("Eres el asistente de atención al cliente de Clínica Dental Lumen en Madrid. Atiende con calidez, cercanía y profesionalidad. Responde basándote en la información de la clínica. Si el cliente quiere pedir cita, confirma primero el servicio deseado, día y hora antes de reservarla.")
  prohibitedActions String   @default("Nunca inventes precios que no estén en la lista oficial. Nunca des diagnósticos médicos ni recomendaciones farmacológicas. Ante una urgencia o dolor severo, ofrece llamar inmediatamente al teléfono de la clínica o acudir de urgencia.")
  operatingHours    String   @default("{\"lunes\":{\"open\":\"09:00\",\"close\":\"20:00\",\"split\":[{\"open\":\"09:00\",\"close\":\"14:00\"},{\"open\":\"16:00\",\"close\":\"20:00\"}]},\"martes\":{\"open\":\"09:00\",\"close\":\"20:00\",\"split\":[{\"open\":\"09:00\",\"close\":\"14:00\"},{\"open\":\"16:00\",\"close\":\"20:00\"}]},\"miercoles\":{\"open\":\"09:00\",\"close\":\"20:00\",\"split\":[{\"open\":\"09:00\",\"close\":\"14:00\"},{\"open\":\"16:00\",\"close\":\"20:00\"}]},\"jueves\":{\"open\":\"09:00\",\"close\":\"20:00\",\"split\":[{\"open\":\"09:00\",\"close\":\"14:00\"},{\"open\":\"16:00\",\"close\":\"20:00\"}]},\"viernes\":{\"open\":\"09:00\",\"close\":\"20:00\",\"split\":[{\"open\":\"09:00\",\"close\":\"14:00\"},{\"open\":\"16:00\",\"close\":\"20:00\"}]},\"sabado\":{\"closed\":true},\"domingo\":{\"closed\":true}}")
  offHoursPolicy    String   @default("TAKE_MESSAGE") // TAKE_MESSAGE, CONTINUE_AND_BOOK
  handoffRules      String   @default("[\"queja\",\"urgencia\",\"pide hablar con alguien\",\"no sabe la respuesta\"]")
  customHandoffRule String?
  safeMode          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Service {
  id                 String   @id @default(cuid())
  name               String
  description        String
  durationMinutes    Int      @default(30)
  price              Float    @default(0.0)
  priceType          String   @default("from") // fixed, from, free
  requiresAssessment Boolean  @default(false)
  isActive           Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  freeText  String   @default("Clínica Dental Lumen cuenta con más de 15 años de experiencia en odontología integral, implantología avanzada, ortodoncia invisible Invisalign y estética dental. Disponemos de tecnología 3D TAC de baja radiación y escáner intraoral iTero.")
  updatedAt DateTime @updatedAt
}

model Integration {
  id                   String   @id @default(cuid())
  provider             String   @unique // google_calendar, gmail, google_sheets, slack, stripe, webhooks
  name                 String
  status               String   @default("disconnected") // disconnected, connected, error
  accountIdentifier    String?
  encryptedCredentials String?  // AES-256-GCM
  settingsJson         String   @default("{}")
  capabilitiesJson     String   @default("{}") // Casillas activas
  lastError            String?
  updatedAt            DateTime @updatedAt
}

model Channel {
  id           String   @id @default(cuid())
  type         String   @unique // whatsapp, webchat
  status       String   @default("disconnected") // disconnected, scanning_qr, connected
  phone        String?
  whatsappLid  String?
  qrCode       String?
  settingsJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model Contact {
  id               String         @id @default(cuid())
  name             String?
  phone            String?
  whatsappLid      String?
  email            String?
  channel          String         @default("whatsapp")
  interest         String?
  bookedAppointment Boolean       @default(false)
  notes            String?
  conversations    Conversation[]
  appointments     Appointment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Conversation {
  id            String    @id @default(cuid())
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       String    @default("whatsapp") // whatsapp, webchat
  status        String    @default("ai_active") // ai_active, human_takeover, closed
  lastMessageAt DateTime  @default(now())
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // customer, assistant, human
  content        String
  mediaType      String?      // text, audio, image
  toolCallsJson  String?      // Registro de herramientas invocadas
  createdAt      DateTime     @default(now())
}

model Appointment {
  id               String   @id @default(cuid())
  contactId        String
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceName      String
  startTime        DateTime
  endTime          DateTime
  calendarEventId  String?
  status           String   @default("confirmed") // confirmed, cancelled, rescheduled
  reminderSent     Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  provider    String   // assistant, google_calendar, gmail, google_sheets, slack, stripe, webhooks, whatsapp
  channel     String   @default("whatsapp") // whatsapp, webchat, system
  status      String   // success, error, simulated
  detailsJson String?
  errorText   String?
  createdAt   DateTime @default(now())
}

model WorkerCommand {
  id          String   @id @default(cuid())
  command     String
  payloadJson String?
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
}
