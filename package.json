{
  "name": "atiende",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n \"db,web,worker\" -c \"blue,green,magenta\" \"npm run dev:db\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:db": "tsx scripts/local-db.ts",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "start:worker": "tsx src/worker/index.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "googleapis": "^188.0.0",
    "jose": "^6.2.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.0.1",
    "walk-up-path": "^4.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
