# =================================================================
# TROPIGO - PLATAFORMA DE DELIVERY & MOVILIDAD (IVIRGARZAMA, BOLIVIA)
# VARIABLES DE ENTORNO (PRESUPUESTO 0 BS / SERVICIOS GRATUITOS FREE TIER)
# =================================================================

# URL base y Puerto (http://localhost:3000 en local, o tu URL https://tropigo.vercel.app)
PORT=3000
APP_URL=http://localhost:3000

# -----------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (COMPATIBLE CON VERCEL / NEON / SUPABASE)
# -----------------------------------------------------------------
# En local: Usa el PostgreSQL local de prueba en puerto 5433 sin instalar nada.
# En producción Vercel: Neon Free Tier (https://neon.tech) o Supabase Free (https://supabase.com)
DATABASE_URL="postgres://postgres:postgres@localhost:5433/template1?sslmode=disable&pgbouncer=true"
# DIRECT_URL="" # Opcional: Requerido solo por Neon/Supabase si usas Connection Pooling en Vercel

# -----------------------------------------------------------------
# 2. AUTENTICACIÓN Y SEGURIDAD
# -----------------------------------------------------------------
# Administrador inicial para inicio de sesión en /login
ADMIN_EMAIL=admin@tropigo.bo
ADMIN_PASSWORD=AdminTropigo2025!

# Clave de cifrado AES-256-GCM para proteger credenciales en BD (32 bytes hex)
ENCRYPTION_KEY=9f8b4a2e1d7c3b5a6f8e0d2c4b6a8f0e1d3c5b7a9f0e2d4c6b8a0f1e3d5c7b9a

# -----------------------------------------------------------------
# 3. MOTOR DE INTELIGENCIA ARTIFICIAL (GROQ API - PLAN GRATUITO 100%)
# -----------------------------------------------------------------
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Proveedor de IA alternativo (opcional / fallback si Groq no está configurado)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5

# -----------------------------------------------------------------
# 4. CANAL DE WHATSAPP (DUAL-ENGINE MODULAR)
# -----------------------------------------------------------------
# WHATSAPP_PROVIDER: "BAILEYS_QR" (local/worker) o "META_CLOUD_API" (oficial Vercel Serverless)
WHATSAPP_PROVIDER=BAILEYS_QR
WHATSAPP_SESSION_DIR=./data/whatsapp_session

# Meta Cloud API (Oficial - Opcional, mantener vacío si no tienes cuenta comercial)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_SYSTEM_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=tropigo_verify_token_2025
META_APP_SECRET=

# -----------------------------------------------------------------
# 5. INTEGRACIONES ADICIONALES (MODULARES / DESACTIVADAS POR DEFECTO)
# -----------------------------------------------------------------
# Google Calendar (OAuth2 para entregas programadas o catering)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificaciones y Webhooks (n8n / Make / Slack)
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=whsec_tropigo_demo_2025

# Cargar automáticamente los datos iniciales de Ivirgarzama si la base está vacía
SEED_DEMO=true
