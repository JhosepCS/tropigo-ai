# =================================================================
# TROPIGO AI - VARIABLES DE ENTORNO (PLANTILLA)
# Delivery & movilidad en Ivirgarzama, Tropico de Cochabamba (Bolivia)
# Stack 100% gratuito: Vercel + Supabase + Google Gemini
#
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git ni a un enlace publico.
# =================================================================

# URL publica del panel web (Vercel) y puerto local
PORT=3000
APP_URL=http://localhost:3000

# -----------------------------------------------------------------
# 1. BASE DE DATOS (SUPABASE - POSTGRESQL GRATUITO)
# -----------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string
# Reemplaza TU_PROJECT_REF, TU_REGION y TU_PASSWORD por tus datos.
# Transaction pooler (puerto 6543) para la app en Vercel:
DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
# Session pooler (puerto 5432) para migraciones y Prisma Studio:
DIRECT_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# En local con PostgreSQL de prueba en 5433 (solo desarrollo):
# DATABASE_URL="postgres://postgres:postgres@localhost:5433/template1?sslmode=disable&pgbouncer=true"
# DIRECT_URL="postgres://postgres:postgres@localhost:5433/template1?sslmode=disable"

# -----------------------------------------------------------------
# 2. AUTENTICACION Y SEGURIDAD
# -----------------------------------------------------------------
ADMIN_EMAIL=admin@tropigo.bo
# Obligatoria para ejecutar el seed. Usa una contrasena fuerte y no la versiones.
ADMIN_PASSWORD=cambia_esta_clave
OPERATOR_PASSWORD=cambia_esta_clave

# Cifrado AES-256-GCM de credenciales y firma de sesiones JWT.
# Genera una clave nueva con: openssl rand -hex 32
# Debe tener 64 caracteres hexadecimales. NUNCA la compartas ni la subas al repo.
ENCRYPTION_KEY=genera_una_clave_de_64_caracteres_hex_con_openssl_rand_hex_32

# -----------------------------------------------------------------
# 3. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI - GRATUITO)
# -----------------------------------------------------------------
# Clave gratuita: https://aistudio.google.com/apikey
# Un solo motor para texto, vision (imagenes) y audio (notas de voz).
GEMINI_API_KEY=
GEMINI_MULTIMODAL_MODEL=gemini-3.1-flash-lite

# Opcional: Groq como respaldo de texto/Whisper (si la clave es valida)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Opcionales (no necesarios para el flujo principal)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5

# -----------------------------------------------------------------
# 4. CANAL DE WHATSAPP
# -----------------------------------------------------------------
# META_CLOUD_API: webhook oficial de Meta (recomendado; no necesita worker).
# BAILEYS_QR: worker persistente con QR (no oficial; puede bloquear el numero).
WHATSAPP_PROVIDER=META_CLOUD_API
WHATSAPP_SESSION_DIR=./data/whatsapp_session
# Guarda la sesion de Baileys en Supabase para sobrevivir reinicios
WHATSAPP_SESSION_PERSIST=true
WHATSAPP_BATCH_DELAY_MS=6000

# Meta Cloud API (se guardan desde el CRM; tambien puedes dejarlas aqui)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_SYSTEM_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=tropigo_verify_token_2025
META_APP_SECRET=

# -----------------------------------------------------------------
# 5. INTEGRACIONES OPCIONALES
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps (opcional: distancia real por carretera y ETA de viaje)
# Si no se configura, el sistema usa distancia estimada por Haversine x 1.3
GOOGLE_MAPS_API_KEY=

# Google Calendar (opcional: agendamiento automatico de pedidos)
# GOOGLE_CALENDAR_ID=tu-calendario@gmail.com o primary
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=whsec_tropigo_demo_2025

# -----------------------------------------------------------------
# 6. DESPLIEGUE
# -----------------------------------------------------------------
# Migraciones automaticas en el contenedor web (Docker)
RUN_MIGRATIONS=false
# NUNCA activar en produccion con datos reales: el seed borra y recrea datos.
SEED_DEMO=false
