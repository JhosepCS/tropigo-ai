# =================================================================
# «ATIENDE» - VARIABLES DE ENTORNO
# =================================================================

# Puerto y URL base (http://localhost:3000 en local, https://[subdominio] en producción)
PORT=3000
APP_URL=http://localhost:3000

# Base de datos PostgreSQL
# En local, arranca automáticamente con Prisma dev en el puerto 5433 sin instalar nada
DATABASE_URL="postgres://postgres:postgres@localhost:5433/template1?sslmode=disable&pgbouncer=true"

# Administrador inicial para inicio de sesión en /login
ADMIN_EMAIL=admin@atiende.es
ADMIN_PASSWORD=AdminAtiende2025!

# Clave de cifrado AES-256-GCM para tokens de Google, Stripe y Webhooks (32 bytes hex)
ENCRYPTION_KEY=9f8b4a2e1d7c3b5a6f8e0d2c4b6a8f0e1d3c5b7a9f0e2d4c6b8a0f1e3d5c7b9a

# Proveedor de IA OpenRouter (OpenAI compatible)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5

# WhatsApp Baileys: ruta persistente de sesión en disco
WHATSAPP_SESSION_DIR=./data/whatsapp_session

# Google OAuth Incremental (Calendar, Gmail y Sheets comparten el mismo cliente)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack (Incoming Webhook URL)
SLACK_WEBHOOK_URL=

# Stripe (Clave restringida rk_test_... o rk_live_...)
STRIPE_SECRET_KEY=

# Webhooks Salientes (URL de destino para n8n, Make o Zapier)
WEBHOOK_URL=
WEBHOOK_SECRET=whsec_atiende_demo_2025

# Cargar automáticamente los datos de demostración de Clínica Dental Lumen si la base está vacía
SEED_DEMO=true
