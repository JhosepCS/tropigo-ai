# =================================================================
# ATIENDE / TROPIGO DELIVERY - VARIABLES DE ENTORNO
# =================================================================

# URL base de la aplicación y puerto
PORT=3000
APP_URL=http://localhost:3000

# Base de datos PostgreSQL (En local arranca automáticamente con PGlite en el puerto 5433)
DATABASE_URL="postgres://postgres:postgres@localhost:5433/template1?sslmode=disable"

# Administrador inicial para inicio de sesión
ADMIN_EMAIL=admin@tropigo.bo
ADMIN_PASSWORD=AdminTropigo2025!

# Clave de cifrado AES-256-GCM para tokens y credenciales (32 bytes hex = 64 caracteres)
ENCRYPTION_KEY=9f8b4a2e1d7c3b5a6f8e0d2c4b6a8f0e1d3c5b7a9f0e2d4c6b8a0f1e3d5c7b9a

# Proveedor de IA (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-haiku

# Transcripción de audios (Groq Whisper / OpenAI Whisper)
GROQ_API_KEY=
OPENAI_API_KEY=

# Canales de WhatsApp: Proveedor activo ('BAILEYS_QR' o 'META_CLOUD_API')
WHATSAPP_ACTIVE_PROVIDER=BAILEYS_QR
WHATSAPP_SESSION_DIR=./data/whatsapp_session

# Meta WhatsApp Cloud API Oficial (opcional cuando se active el modo oficial)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_SYSTEM_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=tropigo_verify_token_2025
META_APP_SECRET=

# Integraciones de Notificación y Pagos (Opcionales)
SLACK_WEBHOOK_URL=
STRIPE_SECRET_KEY=
WEBHOOK_URL=
WEBHOOK_SECRET=

# Carga de datos de demostración si la base está vacía
SEED_DEMO=true
